rules_version = '2';

// machranga-eae85 Firestore: Money Manager + Pomodoro (AdMCQ এর ডাটা Turso তে, এখানে নয়)
// একই ফাইল money-manager-app/firestore.rules এও আছে; বদলালে দুই জায়গাতেই বদলাও।
service cloud.firestore {
  match /databases/{database}/documents {

    // প্রত্যেকে শুধু নিজের ডাটা: প্রোফাইল, লেনদেন, বাজেট, টাস্ক, সেশন, সেটিংস
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // স্টাডি গ্রুপের চ্যাট: লগইন করা সবাই পড়বে; নিজের নামে নতুন মেসেজ দিতে পারবে, বদলানো/মোছা যাবে না
    match /groups/{groupId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
    }

    // Pomodoro লিডারবোর্ড (board = সপ্তাহের শনিবারের তারিখ বা "all"): লগইন করা সবাই পড়বে, প্রত্যেকে শুধু নিজের ঘরে লিখবে।
    // নতুন ঘর বানানোর সময়ও ৩ ঘণ্টার (১৮০ মিনিট) বেশি দিয়ে শুরু করা যায় না (আগে ১০০০০০ পর্যন্ত যেত, তাতে এক লাফে ১ নম্বর হওয়া যেত);
    // পরে একবারে ৩ ঘণ্টার বেশি বাড়ানো যায় না, কমানোও যায় না। মোছা যায় না। (lib/leaderboard.ts এর CREATE_MAX এর সাথে মিলিয়ে রাখো)
    match /leaderboards/{board}/users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && validEntry()
        && request.resource.data.get('minutes', 0) <= 180;
      allow update: if request.auth != null && request.auth.uid == uid && validEntry()
        && request.resource.data.get('minutes', 0) >= resource.data.get('minutes', 0)
        && request.resource.data.get('minutes', 0) <= resource.data.get('minutes', 0) + 180;
    }

    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'hidden', 'minutes', 'sessions'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 40))
        && (!('hidden' in d) || d.hidden is bool)
        && (!('minutes' in d) || (d.minutes is int && d.minutes >= 0))
        && (!('sessions' in d) || (d.sessions is int && d.sessions >= 0));
    }

    // বাকি সব বন্ধ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
